# {{projectName}} — 本地编排 / local orchestration
services:
  app:
    build: .
    image: {{imageRepo}}/{{projectSlug}}:{{imageTag}}
    ports:
      - "{{exposePort}}:{{exposePort}}"
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://localhost:{{exposePort}}{{healthzPath}}"]
      interval: 30s
      timeout: 3s
      retries: 3
    # 占位依赖 / placeholder dependencies（按需启用）
