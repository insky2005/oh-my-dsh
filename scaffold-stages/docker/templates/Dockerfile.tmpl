# {{projectName}} — 多阶段构建 / multi-stage build（runtime: {{runtime}}）
{{#if runtime.java}}
# ---- build stage ----
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app
COPY pom.xml .
RUN mvn -q dependency:go-offline
COPY src ./src
RUN mvn -q package

# ---- runtime stage ----
FROM eclipse-temurin:21-jre
# 安装 curl 供 HEALTHCHECK 使用（temurin JRE 默认不含探活工具）
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/target/*.jar app.jar
EXPOSE {{exposePort}}
HEALTHCHECK --interval=30s --timeout=3s CMD curl -fsS http://localhost:{{exposePort}}{{healthzPath}} || exit 1
ENTRYPOINT ["java", "-jar", "app.jar"]
{{/if}}{{#if runtime.node}}
# ---- build stage ----
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

# ---- runtime stage ----
FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app ./
EXPOSE {{exposePort}}
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://localhost:{{exposePort}}{{healthzPath}} || exit 1
CMD ["node", "dist/main.js"]
{{/if}}{{#if runtime.static}}
# ---- build stage ----
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

# ---- runtime stage ----
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
# nginx 监听 exposePort（见 nginx.conf），SPA 深链 fallback + /healthz 探活端点
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE {{exposePort}}
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://localhost:{{exposePort}}{{healthzPath}} || exit 1
{{/if}}{{#if runtime.go}}
# ---- build stage ----
FROM golang:1.22-alpine AS build
WORKDIR /app
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o bin/app .

# ---- runtime stage ----
FROM alpine:3.20
RUN apk add --no-cache ca-certificates wget
WORKDIR /app
COPY --from=build /app/bin/app .
EXPOSE {{exposePort}}
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://localhost:{{exposePort}}{{healthzPath}} || exit 1
ENTRYPOINT ["./app"]
{{/if}}{{#if runtime.python}}
# ---- build stage ----
FROM python:3.12-slim AS build
WORKDIR /app
COPY requirements*.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY . .

# ---- runtime stage ----
FROM python:3.12-slim
# 安装 curl 供 HEALTHCHECK 使用（python slim 默认不含探活工具）
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app ./
RUN pip install --no-cache-dir gunicorn
ENV PYTHONUNBUFFERED=1
EXPOSE {{exposePort}}
HEALTHCHECK --interval=30s --timeout=3s CMD curl -fsS http://localhost:{{exposePort}}{{healthzPath}} || exit 1
CMD ["gunicorn", "--bind", "0.0.0.0:{{exposePort}}", "app:app"]
{{/if}}
