# {{projectName}} — nginx（static runtime）监听 {{exposePort}}
server {
    listen {{exposePort}};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # 健康检查端点：统一返回 200，不依赖静态资源是否存在
    location = {{healthzPath}} {
        default_type text/plain;
        return 200 'ok';
    }

    # SPA 深链 fallback：未命中文件回退到 index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
