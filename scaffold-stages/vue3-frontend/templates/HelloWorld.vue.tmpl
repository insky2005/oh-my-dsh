<script setup lang="ts">
import { ref } from 'vue'

const title = ref('Hello Vue 3 + Vite + TypeScript')
const count = ref(0)
function inc() { count.value++ }
</script>

<template>
  <section class="hello">
    <h1 v-text="title" />
    <button type="button" @click="inc">
      clicked <output v-text="count" /> times
    </button>
  </section>
</template>

<style scoped>
.hello h1 { color: #42b883; }
.hello button { font-size: 1rem; padding: 0.4rem 0.8rem; }
</style>
