# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# build artifacts (repo root + platforms/macos)
.build/
.cache/
dist/
platforms/macos/.build/
platforms/macos/.cache/
platforms/macos/dist/

# Node (shared core + embedded runtime)
node_modules/
platforms/*/node_modules/
core/node_modules/
*.node

# logs
*.log
logs/
*.pid

# env / secrets
.env
.env.*
!.env.example

# debug screenshots / QA artifacts (local only)
pic/

# task association index: machine-scoped session overlay (index.json IS committed)
.dsh/tasks/local.json

# Xcode / Swift
DerivedData/
*.xcuserstate
xcuserdata/
*.swiftmodule
*.swiftdoc
.build/module-cache/

# packaging leftovers
*.dmg
*.pkg
*.pkg.dist
*.app.dSYM

# editor / OS
.vscode/
.idea/
*.swp
*~
Thumbs.db

# channel message/session files (user content, not committed; config .dsh/channels.json IS committed)
.dsh/channels/*.messages.json
.dsh/channels/*.sessions.json
