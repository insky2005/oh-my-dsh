# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# build artifacts (repo root + platforms/macos)
.build/
.cache/
dist/
platforms/macos/.build/
platforms/macos/.cache/
platforms/macos/dist/

# Node (shared core + embedded runtime)
node_modules/
platforms/*/node_modules/
core/node_modules/
*.node

# logs
*.log
logs/
*.pid

# env / secrets
.env
.env.*
!.env.example

# debug screenshots / QA artifacts (local only)
pic/

# task association index: machine-scoped files (index.json IS committed)
.dsh/tasks/local.json
.dsh/tasks/manual.json
.dsh/tasks/queues.json
# per-queue 汇报全文 written for the wrap-up notification (machine-scoped)
.dsh/tasks/reports/

# requirement/workstream runtime bindings (machine-scoped)
.dsh/workstreams/local.json
.dsh/workstreams/queues.json
.dsh/requirements/local.json

# Xcode / Swift
DerivedData/
*.xcuserstate
xcuserdata/
*.swiftmodule
*.swiftdoc
.build/module-cache/

# packaging leftovers
*.dmg
*.pkg
*.pkg.dist
*.app.dSYM

# editor / OS
.vscode/
.idea/
*.swp
*~
Thumbs.db
