#!/usr/bin/env bash
# {{projectName}} — 安装 Conventional Commits commit-msg 校验钩子（纯 shell，无运行时依赖）
# Install a Conventional Commits commit-msg hook (pure shell, no runtime dependency).
# 非破坏：已有同名钩子先备份到 .scaffold-backup/ 再写入（9.17）。
set -euo pipefail
cd "$(dirname "$0")/.."

[ -d .git ] || { echo "error: no .git directory — run 'git init' first" >&2; exit 1; }
mkdir -p .git/hooks

HOOK=".git/hooks/commit-msg"
if [ -e "$HOOK" ]; then
  BACKUP=".scaffold-backup/$HOOK"
  mkdir -p "$(dirname "$BACKUP")"
  cp "$HOOK" "$BACKUP"
  echo "existing commit-msg hook backed up to $BACKUP"
fi

cat > "$HOOK" <<'VALIDATOR'
#!/usr/bin/env bash
# Conventional Commits validator (pure shell, no runtime dependency)
set -euo pipefail
MSG_FILE="$1"
SUBJECT=$(head -n1 "$MSG_FILE")
if ! printf '%s' "$SUBJECT" | grep -Eq '^(feat|fix|docs|refactor|perf|test|chore|build|ci|revert)(\([a-z0-9_-]+\))?!?: .+'; then
  echo "commit-msg: subject must match Conventional Commits:" >&2
  echo "  <type>(<scope>): <subject>" >&2
  echo "  type in feat|fix|docs|refactor|perf|test|chore|build|ci|revert" >&2
  exit 1
fi
exit 0
VALIDATOR
chmod +x "$HOOK"
echo "installed: $HOOK"
