# {{projectName}} — 多阶段构建 / multi-stage build（runtime: {{runtime}}）
{{#if runtime.java}}
# ---- build stage ----
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app
COPY pom.xml .
RUN mvn -q dependency:go-offline
COPY src ./src
RUN mvn -q package

# ---- runtime stage ----
FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /app/target/*.jar app.jar
EXPOSE {{exposePort}}
HEALTHCHECK --interval=30s --timeout=3s CMD curl -fsS http://localhost:{{exposePort}}{{healthzPath}} || exit 1
ENTRYPOINT ["java", "-jar", "app.jar"]
{{/if}}{{#if runtime.node}}
# ---- build stage ----
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# ---- runtime stage ----
FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app ./
EXPOSE {{exposePort}}
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://localhost:{{exposePort}}{{healthzPath}} || exit 1
CMD ["node", "dist/main.js"]
{{/if}}{{#if runtime.static}}
# ---- build stage ----
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# ---- runtime stage ----
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE {{exposePort}}
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://localhost:{{exposePort}}{{healthzPath}} || exit 1
{{/if}}
